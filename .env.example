# Variables de entorno de PolloRanking.
# Copiar a .env.local (ignorado por git) y completar los valores.

# Connection string de Neon (Dashboard → Connect). Formato:
# postgresql://usuario:contraseña@host.neon.tech/base?sslmode=require
DATABASE_URL=

# Secreto de sesión de Auth.js. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente de OAuth).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis (límite de intentos por IP). Dashboard de Upstash → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# El dominio SEO canónico se define en src/app/_lib/seo.ts (SITE_ORIGIN).
# Auth.js: confiar en el host al correr con "next start" fuera de Vercel (en Vercel no hace falta).
AUTH_TRUST_HOST=true

# Google Analytics 4: ID público del flujo Web (G-XXXXXXXXXX).
# Vacío = desactivado. En Vercel configurar solo para Production y volver a desplegar.
# Desarrollo y previews no envían visitas. Ver docs/analytics.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Correos de Google de los administradores, separados por comas.
# Solo cuentas de Google con correo verificado reciben el rol. Mayúsculas y espacios se ignoran.
# Vacío = nadie es admin. En Vercel, cambiarla requiere volver a desplegar.
# Para las pruebas e2e locales, incluir también e2e-admin@example.com (nunca en Vercel).
ADMIN_EMAILS=
