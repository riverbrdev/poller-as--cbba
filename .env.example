# Variables de entorno de PolloRanking.
# Copiar a .env.local (ignorado por git) y completar los valores.

# Connection string de Neon (Dashboard → Connect). Formato:
# postgresql://usuario:contraseña@host.neon.tech/base?sslmode=require
DATABASE_URL=

# Secreto de sesión de Auth.js. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente de OAuth).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis (límite de intentos por IP). Dashboard de Upstash → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Correos con acceso mientras la app está en pruebas, separados por coma.
# Vacío = sin restricción. Ejemplo: ALLOWED_EMAILS=yo@gmail.com,otra@gmail.com
ALLOWED_EMAILS=
